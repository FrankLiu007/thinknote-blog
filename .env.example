# Optional. Defaults to https://thinknote.pro when unset.
# Used by the article “Save to ThinkNote” CTA.
# Articles hand off markdown via /from-blog#d=... (no blog JSON fetch needed).
#
# Production (current default):
PUBLIC_THINKNOTE_APP_URL=https://thinknote.pro
#
# Test:
# PUBLIC_THINKNOTE_APP_URL=https://test.thinknote.pro
#
# Local frontend:
# PUBLIC_THINKNOTE_APP_URL=http://localhost:5173
