---
import type { Locale } from '../i18n/config';
import { localeHtmlLang } from '../i18n/config';

interface Props {
	date: Date;
	lang?: Locale;
}

const { date, lang = 'en' } = Astro.props;
const locale = localeHtmlLang[lang];
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(locale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
