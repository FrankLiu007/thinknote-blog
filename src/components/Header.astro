---
import { CATEGORY_SLUGS, SITE_TITLE, type CategorySlug } from '../consts';
import { LOCALE_STORAGE_KEY, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { categoryPath, localePath } from '../i18n/utils';
import HeaderLink from './HeaderLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

type Props = {
	lang: Locale;
	/** Path without locale prefix for language switching */
	switchPath?: string;
};

const { lang, switchPath = '' } = Astro.props;
const copy = t(lang);
const homeHref = localePath(lang);
const aboutHref = localePath(lang, 'about');

const normalize = (value: string) => {
	const path = value.replace(/\/+$/, '');
	return path === '' ? '/' : path;
};
const pathname = normalize(Astro.url.pathname.replace(import.meta.env.BASE_URL, '/'));

const activeCategory = ((): CategorySlug | 'all' | null => {
	if (pathname === normalize(homeHref)) return 'all';
	for (const slug of CATEGORY_SLUGS) {
		if (pathname === normalize(categoryPath(lang, slug))) return slug;
	}
	return null;
})();
---

<script is:inline define:vars={{ lang, storageKey: LOCALE_STORAGE_KEY }}>
	try {
		localStorage.setItem(storageKey, lang);
	} catch (_) {}
</script>

<header>
	<nav>
		<a class="brand" href={homeHref}>
			<img
				src="/thinknote-logo.png"
				alt=""
				width="36"
				height="36"
				class="brand-logo"
				decoding="async"
			/>
			<span class="brand-text">{SITE_TITLE}</span>
		</a>

		<div class="nav-topics" aria-label={copy.catalog}>
			<a class:list={[{ active: activeCategory === 'all' }]} href={homeHref}>{copy.all}</a>
			{
				CATEGORY_SLUGS.map((slug) => (
					<a
						class:list={[{ active: activeCategory === slug }]}
						href={categoryPath(lang, slug)}
					>
						{copy.categories[slug].label}
					</a>
				))
			}
		</div>

		<div class="nav-actions">
			<HeaderLink class="about-link" href={aboutHref}>{copy.about}</HeaderLink>
			<LanguageSwitcher lang={lang} path={switchPath} />
			<ThemeToggle />
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 40;
		margin: 0;
		padding: 0 var(--page-gutter);
		background: var(--header-bg);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: 0 1px 0 rgb(var(--gray-light));
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.7em 0.35em 0.7em 0;
		text-decoration: none;
		color: rgb(var(--black));
		border-bottom: none;
		flex-shrink: 0;
		justify-self: start;
	}
	.brand:hover,
	.brand:hover .brand-text {
		color: var(--accent);
	}
	.brand-logo {
		display: block;
		width: 36px;
		height: 36px;
		border-radius: 9px;
		flex-shrink: 0;
	}
	.brand-text {
		font-size: 1.05em;
		font-weight: 700;
		letter-spacing: -0.02em;
		transition: color 0.15s ease;
	}
	/* Side rails for brand / actions; center rail matches main content. */
	nav {
		display: grid;
		grid-template-columns: 1fr minmax(0, var(--page-width)) 1fr;
		align-items: center;
		gap: 0.75em;
		min-height: 3.5em;
		width: 100%;
		margin: 0 auto;
	}
	.nav-topics {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 1.1em;
		min-width: 0;
		justify-self: stretch;
	}
	.nav-topics a {
		padding: 0.35em 0;
		font-size: 0.9em;
		color: rgb(var(--gray));
		text-decoration: none;
		border-bottom: 2px solid transparent;
		white-space: nowrap;
	}
	.nav-topics a:hover {
		color: var(--accent);
	}
	.nav-topics a.active {
		color: rgb(var(--black));
		font-weight: 700;
		border-bottom-color: var(--accent);
	}
	.nav-actions {
		display: flex;
		align-items: center;
		justify-self: end;
		gap: 0.45em;
		flex-shrink: 0;
	}
	.nav-actions :global(.about-link) {
		padding: 0.35em 0.55em;
		font-size: 0.9em;
		font-weight: 600;
		color: rgb(var(--black));
		text-decoration: none;
		border-bottom: none;
	}
	.nav-actions :global(.about-link:hover),
	.nav-actions :global(.about-link.active) {
		color: var(--accent);
		text-decoration: none;
	}
	@media (max-width: 960px) {
		nav {
			grid-template-columns: 1fr auto;
			grid-template-areas:
				'brand actions'
				'topics topics';
			gap: 0 0.75em;
			padding-bottom: 0.45em;
			min-height: 0;
		}
		.brand {
			grid-area: brand;
			padding: 0.55em 0.35em 0.35em 0;
		}
		.brand-text {
			font-size: 0.95em;
		}
		.nav-actions {
			grid-area: actions;
		}
		.nav-topics {
			grid-area: topics;
			justify-content: flex-start;
			gap: 0.85em;
			padding: 0.15em 0 0.35em;
			overflow-x: auto;
			scrollbar-width: none;
			-webkit-overflow-scrolling: touch;
		}
		.nav-topics::-webkit-scrollbar {
			display: none;
		}
		.nav-actions :global(.about-link) {
			padding: 0.35em 0.4em;
		}
	}
</style>
