---
import type { CollectionEntry } from 'astro:content';
import type { CategorySlug } from '../consts';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { categoryPath, getSlugFromId, postPath } from '../i18n/utils';
import FormattedDate from './FormattedDate.astro';

type Props = {
	lang: Locale;
	posts: CollectionEntry<'blog'>[];
	featured?: boolean;
	emptyMessage?: string;
};

const { lang, posts, featured = false, emptyMessage } = Astro.props;
const copy = t(lang);
const message = emptyMessage ?? copy.emptyPosts;
const showFeatured = featured && posts.length > 0;
const first = showFeatured ? posts[0] : undefined;
const listPosts = showFeatured ? posts.slice(1) : posts;
---

{
	posts.length === 0 ? (
		<p class="empty">{message}</p>
	) : (
		<>
			{first && (
				<article class="featured">
					<div class="featured-meta">
						<span class="featured-label">{copy.latest}</span>
						<a class="cat-link" href={categoryPath(lang, first.data.category)}>
							{copy.categories[first.data.category as CategorySlug].label}
						</a>
						<span>
							<FormattedDate date={first.data.pubDate} lang={lang} />
						</span>
					</div>
					<a class="featured-main" href={postPath(lang, getSlugFromId(first.id))}>
						<h2 class="featured-title">{first.data.title}</h2>
						{first.data.description && (
							<p class="featured-desc">{first.data.description}</p>
						)}
					</a>
				</article>
			)}

			{listPosts.length > 0 && (
				<ul class="post-list">
					{listPosts.map((post) => (
						<li>
							<div class="post-row">
								<p class="post-date">
									<FormattedDate date={post.data.pubDate} lang={lang} />
								</p>
								<div class="post-body">
									<a class="cat-badge" href={categoryPath(lang, post.data.category)}>
										{copy.categories[post.data.category as CategorySlug].label}
									</a>
									<a class="post-link" href={postPath(lang, getSlugFromId(post.id))}>
										<h3 class="post-title">{post.data.title}</h3>
										{post.data.description && (
											<p class="post-desc">{post.data.description}</p>
										)}
									</a>
								</div>
							</div>
						</li>
					))}
				</ul>
			)}
		</>
	)
}

<style>
	.empty {
		margin: 2em 0;
		color: rgb(var(--gray));
	}

	.featured {
		padding: 1.25em 0 1.25em 1.25em;
		margin-bottom: 2em;
		border-left: 3px solid var(--accent);
	}
	.featured-main {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.featured-main:hover .featured-title {
		color: var(--accent);
	}
	.featured-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75em;
		margin-bottom: 0.5em;
		font-size: 0.8em;
		color: rgb(var(--gray));
	}
	.featured-label {
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.featured-title {
		margin: 0 0 0.4em;
		font-size: 1.563em;
		line-height: 1.25;
		color: rgb(var(--black));
		transition: color 0.15s ease;
	}
	.featured-desc {
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: 0.95em;
		line-height: 1.5;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.post-list li {
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.post-row {
		display: grid;
		grid-template-columns: 6.5em 1fr;
		gap: 1em;
		align-items: baseline;
		padding: 0.85em 0;
	}
	.post-date {
		margin: 0;
		font-size: 0.8em;
		color: rgb(var(--gray));
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.post-body {
		min-width: 0;
	}
	.cat-link,
	.cat-badge {
		color: var(--accent);
		text-decoration: none;
		font-size: 0.8em;
		font-weight: 600;
	}
	.cat-badge {
		display: inline-block;
		margin-bottom: 0.2em;
	}
	.cat-link:hover,
	.cat-badge:hover {
		text-decoration: underline;
	}
	.post-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.post-link:hover .post-title {
		color: var(--accent);
	}
	.post-title {
		margin: 0;
		font-size: 1.05em;
		font-weight: 700;
		line-height: 1.35;
		color: rgb(var(--black));
		transition: color 0.15s ease;
	}
	.post-desc {
		margin: 0.25em 0 0;
		font-size: 0.85em;
		line-height: 1.45;
		color: rgb(var(--gray));
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (max-width: 720px) {
		.featured {
			padding-left: 1em;
		}
		.post-row {
			grid-template-columns: 1fr;
			gap: 0.2em;
		}
	}
</style>
