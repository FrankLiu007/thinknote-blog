---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SaveArticleMenu from '../components/SaveArticleMenu.astro';
import type { CategorySlug } from '../consts';
import { localeHtmlLang, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { categoryPath } from '../i18n/utils';

type Props = {
	lang: Locale;
	switchPath?: string;
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string | ImageMetadata;
	category?: CategorySlug;
	markdown?: string;
};

const {
	lang,
	switchPath = '',
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	markdown = '',
} = Astro.props;
const copy = t(lang);
const categoryMeta = category ? copy.categories[category] : undefined;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const heroImageUrl =
	typeof heroImage === 'string'
		? new URL(heroImage.startsWith('/') ? heroImage : `/${heroImage}`, Astro.site).href
		: heroImage && typeof heroImage === 'object' && 'src' in heroImage
			? new URL(String(heroImage.src), Astro.site).href
			: '';
---

<html lang={localeHtmlLang[lang]}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
		<style>
			main {
				width: var(--page-width);
				max-width: calc(100% - 2 * var(--page-gutter));
				margin: 0 auto;
				padding: 1.5em 0 3em;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				margin: 0;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 100%;
				margin: 0;
				padding: 1.25em 0 0;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.category {
				display: inline-block;
				margin-bottom: 0.75em;
				font-size: 0.85em;
				font-weight: 600;
				text-decoration: none;
			}
			.category:hover {
				text-decoration: underline;
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header lang={lang} switchPath={switchPath} />
		<main>
			<article>
				<div class="hero-image">
					{
						heroImage &&
							(typeof heroImage === 'string' ? (
								<img width={1200} height={630} src={heroImage} alt="" />
							) : (
								<Image width={1200} height={630} src={heroImage} alt="" />
							))
					}
				</div>
				<div class="prose">
					<div class="title">
						{
							categoryMeta && category && (
								<a class="category" href={categoryPath(lang, category)}>
									{categoryMeta.label}
								</a>
							)
						}
						<div class="date">
							<FormattedDate date={pubDate} lang={lang} />
							{
								updatedDate && (
									<div class="last-updated-on">
										{copy.lastUpdated} <FormattedDate date={updatedDate} lang={lang} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer lang={lang} />
		<SaveArticleMenu
			lang={lang}
			canonicalUrl={canonicalUrl}
			title={title}
			markdown={markdown}
			heroImage={heroImageUrl}
		/>
	</body>
</html>
